{
    "name": "workout-planner-root",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "npx prisma generate --schema=./prisma/schema.prisma && cd workout-planner/client && npm run build",
        "prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma",
        "db:migrate": "npx prisma migrate deploy --schema=./prisma/schema.prisma",
        "db:seed": "node prisma/seed-exercises.mjs",
        "db:deploy": "npm run db:migrate && npm run db:seed",
        "media:audit": "node scripts/video/audit_exercise_media.mjs",
        "media:audit:strict": "node scripts/video/audit_exercise_media.mjs --strict",
        "recommendation:audit": "node scripts/recommendation/audit_library.mjs",
        "recommendation:audit-plans": "node -r ts-node/register scripts/recommendation/repair_duplicate_plans.ts",
        "recommendation:repair-plans": "node -r ts-node/register scripts/recommendation/repair_duplicate_plans.ts --apply",
        "postinstall": "npx prisma generate --schema=./prisma/schema.prisma"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@vercel/node": "^3.0.0",
        "jsonwebtoken": "^9.0.2",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.0.0",
        "prisma": "^5.22.0",
        "typescript": "^5.3.0"
    }
}
